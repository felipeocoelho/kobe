# Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui
# CSV de user IDs autorizados
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJ...

# Groq (transcrição)
GROQ_API_KEY=gsk_...

# Anthropic (caso Claude Code use API key em vez de OAuth)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings pro Chat Manager — text-embedding-3-small)
# Obtenha em https://platform.openai.com/api-keys e adicione créditos
# em Billing (mínimo $5 dura anos no uso típico). Custo estimado: ~$0.01/mês.
# Também é o FALLBACK do plugin Monet (geração de imagem via gpt-image-1).
OPENAI_API_KEY=sk-proj-...

# Google Gemini — backend principal do plugin Monet (gemini-2.5-flash-image).
# Obtenha em https://aistudio.google.com/apikey. ~$0.039 por imagem gerada.
GEMINI_API_KEY=AIza...

# Chat Manager (Fases 1-7 implementadas; ligar quando confiar). Quando
# true, detector de tema cria/reabre/troca conversations automaticamente
# a cada msg, e o prompt do Hal carrega cronologia comprimida das
# sessions arquivadas da conversation. Quando false, sistema antigo
# (sessions ortogonais) segue intacto.
CHAT_MANAGER_ENABLED=false

# Memória de trabalho (Highlander Frente 0 — desacoplada da flag de conversas):
# governa a JANELA de memória (imediata vs histórico de sessão legado) e a
# compactação. DEFAULT-ON = janela imediata + sem compactação (design Highlander).
# Off = histórico de sessão legado + compactação aos 40 msgs. Chat Manager
# (acima) agora cuida SÓ de conversas; memória é esta flag.
WORKING_MEMORY_ENABLED=true

# Núcleo curado global (Highlander Frente 1.2): auto-injeta USER.md + MEMORY.md
# (identidade do operador + fatos duráveis do agente) no topo do prompt, com
# teto e sinal de consolidação. DEFAULT-ON (puro-cômputo, no-op se faltar
# arquivo). Pra desligar: CURATED_CORE_ENABLED=false + restart.
CURATED_CORE_ENABLED=true

# Sinais de grounding baratos (Highlander Frente 1.1): injeta no prompt o que
# muda com o tempo e o agente senão narraria de memória — hoje, há quanto tempo
# foi a última troca neste tópico (anti-confabulação temporal + lembrete de
# retomada). DEFAULT-ON (no-op se não há histórico). Desligar: =false + restart.
GROUNDING_SIGNALS_ENABLED=true

# Gate de estado de background vivo (Highlander v2, P1): a cada turno o código lê
# os arquivos de estado dos trabalhos de background DESTE tópico (Coder/Atrus),
# carimba a idade, e injeta o fato vivo + a regra dura "use isto, não memória" —
# pra o agente nunca narrar status de sala/job de memória (a dor da "sala
# esperando" que já tinha acabado). Read-only, best-effort. DEFAULT-ON (no-op se
# não há trabalho recente). Desligar: =false + restart.
BACKGROUND_STATE_GATE_ENABLED=true

# Memória durável via Hindsight (Highlander Frente 2.3 / v2): retain (escrita) +
# recall (leitura injetada no turno). Exige o serviço Hindsight de pé (ver
# infra/hindsight/). Best-effort: serviço fora = falha rápido e o turno segue.
#
# HINDSIGHT_ENABLED é o MASTER (off = nem retain nem recall). A v2 (F1) separou
# em duas sub-flags com perfis de risco opostos:
#  - HINDSIGHT_RETAIN=true  → segue gravando a memória em silêncio (barato, seguro).
#  - HINDSIGHT_RECALL=false → NÃO injeta o destilado todo turno (de-risca a
#    confabulação que a Auditoria nomeou). Re-ligar (=true) quando a F3 re-fiar o
#    recall pro best-practice e a régua medir que a alucinação caiu.
HINDSIGHT_ENABLED=true
HINDSIGHT_RETAIN=true
HINDSIGHT_RECALL=false
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_TIMEOUT_SECONDS=10
HINDSIGHT_RECALL_LIMIT=5

# Paths (preenchidos pelo instalador)
KOBE_HOME=/home/seu_usuario/projetos/kobe
KOBE_CLAUDE_CWD=/home/seu_usuario/projetos/kobe

# Config
LOG_LEVEL=INFO
CLAUDE_TIMEOUT_SECONDS=300
RECENT_MESSAGES_LIMIT=20
# Quantas mensagens uma sessão ativa pode acumular antes da compactação
# automática (v0.12). Quando atingido, o bot gera summary via Claude,
# arquiva a sessão (status='compacted') e abre uma nova com o summary
# como contexto inicial. Threshold ALTO = prompts maiores, mais tokens.
# Threshold BAIXO = mais transições, mais chamadas de summary.
COMPACT_THRESHOLD_MESSAGES=40

# ─── Despacho de turno pesado em background (cascata de filtros) ───
# Quando true, a ENTRADA do turno classifica se o pedido vai gerar trabalho
# pesado (editar código, varrer repo, análise longa, processar arquivos/URLs)
# e, se for, despacha o `claude -p` em background FORA do lock do tópico —
# o Hal (atendente) fica livre pro próximo pedido na hora. O resultado do
# pesado chega de forma assíncrona (mensagem depois). Quando false, o sistema
# clássico roda intacto (turno foreground, lock segurado o turno inteiro).
# Rollback trivial: flag off + restart. Ver bot/turn_classifier.py e
# docs/runbooks/despacho-turno-pesado.md.
HEAVY_DISPATCH_ENABLED=false
# Retaguarda (teto de tempo): turno que entrou foreground mas estoura estes
# segundos segurando o lock se promove sozinho pra background e libera a
# linha (o claude em voo NÃO recomeça — continua e reporta no fim). É o
# tempo máximo que se aceita ficar preso no pior caso (erro de previsão).
# Baixo (6-8s) = libera rápido mas chuta turnos legítimos longos pro async;
# alto (15-20s) = quase nunca chuta à toa mas erro real custa mais espera.
HEAVY_DISPATCH_PROMOTE_AFTER_SECONDS=12
# Cortes do placar da cascata. score >= HIGH → background na entrada (previsão);
# score <= LOW → foreground; faixa do meio acorda o GPT-4o-mini pra desempatar
# (zona cinza, ~1s, fora da cota do plano Max). Subir HIGH = menos previsões
# de background; subir LOW = mais chamadas ao mini.
HEAVY_DISPATCH_SCORE_HIGH=6
HEAVY_DISPATCH_SCORE_LOW=2
# Teto de tempo do `claude -p` no caminho de despacho pesado (background, tanto
# na previsão quanto na promoção). O turno de bg é o PESADO por definição —
# 300s (default do foreground) corta no meio e a resposta chega truncada
# ("estourei o tempo limite no meio"). Dimensionado pro trabalho pesado real,
# não infinito. Só vale com HEAVY_DISPATCH_ENABLED=true.
HEAVY_DISPATCH_TIMEOUT_SECONDS=1200
# Watchdog de ACK no background: se a run de bg não emitir um `kobe-notify`
# (ack na voz do Hal, que nomeia a ação) dentro destes segundos e ainda
# estiver rodando, o código manda o aviso enlatado como piso garantido — o
# operador nunca fica no escuro mesmo que o Hal não acke a tempo.
HEAVY_DISPATCH_ACK_FALLBACK_SECONDS=20

# ─── Nova arquitetura de borda (4 peças, cada uma atrás de flag, default off) ───
# Transforma a borda de "cano que repassa" em "balcão que atende". Cada flag é
# independente e reversível (flag off + restart volta ao comportamento de hoje).
# Ver CHANGELOG e docs/runbooks/nova-arquitetura-borda.md.
#
# Peça D — Anexos multimodais: aceita QUALQUER arquivo/imagem (paridade com o
# Claude Desktop pro dono), salva o original em uploads/ do tópico (separado do
# knowledge/ curado), cataloga em user-data/uploads-catalogo.md, e correlaciona
# anexo+instrução no mesmo turno (foto passa a funcionar). Off = legado
# (.txt/.md/.pdf/.docx → knowledge/, foto ignorada).
EDGE_UPLOADS_ENABLED=false
#
# Peça A — Message Assembler: agrega mensagens picadas por debounce de silêncio
# num turno só (antes do FIFO). Janelas em ms, tunáveis (calibração no uso):
# QUIET = silêncio base; QUIET_TERMINATED = frase terminada em pontuação dispara
# mais rápido; MAX_WAIT = teto de espera desde o 1º fragmento. Off = 1 msg = 1 turno.
EDGE_ASSEMBLER_ENABLED=false
EDGE_ASSEMBLER_QUIET_MS=2500
EDGE_ASSEMBLER_QUIET_TERMINATED_MS=700
EDGE_ASSEMBLER_MAX_WAIT_MS=9000
#
# Peça C — Resposta limpa: a resposta final vem sem o rascunho pré-ferramenta
# grudado (que aparece efêmero no canal de progresso e some). Off = concatena
# tudo (comportamento de 2026-06-01).
EDGE_CLEAN_RESPONSE_ENABLED=false
#
# Peça B — Liveness Protocol: o ACK das tarefas pesadas vira GARANTIA da borda
# (LIV-ack semântico escrito por modelo barato, gpt-4o-mini) e o aviso enlatado
# de background é aposentado. Off = ack model-driven + enlatado + watchdog de hoje.
EDGE_LIVENESS_ENABLED=false
#
# Ack do Liveness — anti-invenção e modelo trocável (2026-08-20).
# O ack estava inventando plano/arquivo/ferramenta porque o prompt mandava
# "NOMEAR a ação" a um modelo que só vê a mensagem do operador — pedir
# especificidade a quem não tem informação nenhuma produz chute. O prompt foi
# invertido (proíbe fato novo, manda ancorar nas palavras do operador) e ganhou
# um guarda-costas programático, com chave PRÓPRIA:
#
# Rejeita o ack que introduza número, caminho/extensão de arquivo, ou termo
# técnico (arquivo, script, banco, log, VPS, minuto…) que NÃO esteja na
# mensagem do operador — cai no texto fixo, que não inventa nada. Conservador
# de propósito: pode derrubar um ack legítimo de vez em quando (o preço é ver o
# texto fixo). Deixe ligado e avalie; o log mostra o que foi rejeitado.
LIVENESS_ACK_GUARD_ENABLED=false
#
# Modelo que escreve o ack. Default = o de hoje (openai/gpt-4o-mini, fora da
# cota do plano Max). Trocar por Haiku depois é só mudar estas duas linhas +
# restart, sem obra. Provedores: openai | anthropic.
LIVENESS_ACK_PROVIDER=openai
LIVENESS_ACK_MODEL=gpt-4o-mini

# ─── Reações de recebimento (👀 / ✍) ───
# Sinal de "chegou" IMEDIATO e impossível de alucinar: não passa por modelo
# nenhum — é chamada direta à API do Telegram, disparada no instante em que a
# mensagem entra (antes do montador da borda e do classificador). O Telegram
# permite UMA reação por mensagem e a nova SUBSTITUI a anterior, o que
# transforma a própria mensagem num semáforo de estágio:
#     texto/áudio/anexo chega → 👀     transcrição do áudio pronta → ✍
# Efeito colateral desejado: turno que morre calado fica VISÍVEL (o 👀 aparece
# e o silêncio depois dele grita). Off = nenhuma reação (comportamento legado).
TELEGRAM_REACTIONS_ENABLED=false
# Emojis configuráveis: a lista permitida é do Telegram e pode mudar sem aviso
# (🎧 e 👂, por exemplo, NÃO são aceitos — retornam REACTION_INVALID). Vazio
# desliga aquele estágio sem tocar em código. Emoji fora da lista NÃO quebra
# calado: cai no padrão e grava um aviso no log dizendo qual valor foi recusado.
# Atenção à forma exata: o emoji da mão é "✍" (sem o marcador invisível de cor
# que alguns teclados grudam) — o bot normaliza, mas copie do jeito certo.
TELEGRAM_REACTION_RECEIVED=👀
TELEGRAM_REACTION_TRANSCRIBED=✍

# ─── Robustez do banco e garantia de turno ───
# Duas camadas contra a perda SILENCIOSA de mensagem (o operador manda algo
# depois de um tempo parado e simplesmente não vem resposta nenhuma).
#
# Camada 1 — CONEXÃO (específica do driver, isolada em bot/db.py). Conexão
# ociosa é derrubada do outro lado e a primeira requisição depois morre
# ("Server disconnected"). Aqui: recicla o cliente preventivamente depois de
# DB_IDLE_RECYCLE_SECONDS parado, e repete a consulta em erro de TRANSPORTE
# (erro de negócio NÃO é repetido). Off = comportamento legado, sem rede.
DB_RESILIENCE_ENABLED=true
DB_IDLE_RECYCLE_SECONDS=120
# Repetir também ESCRITAS. Trade-off: se o servidor gravou mas a resposta se
# perdeu, a repetição duplica uma linha (remotíssimo — a conexão estava morta
# antes do pedido sair). Uma linha duplicada é menos grave que uma mensagem
# perdida; false desliga só isso e mantém o retry de leitura.
DB_RETRY_WRITES=true
#
# Camada 2 — GARANTIA (agnóstica de banco: vale pra Supabase, pro Postgres
# local e pro que vier depois). Turno que levanta exceção → a mensagem é
# gravada em user-data/pending-turns/, uma retentativa automática roda quando
# é seguro (erro de transporte E antes de o turno ter gravado qualquer coisa),
# e o operador é AVISADO se não der. No arranque, o que sobrou é REPORTADO —
# não reprocessado (mensagem de horas atrás não deve virar resposta do nada).
# Off = a exceção volta a subir como antes.
TURN_GUARANTEE_ENABLED=true

# ─── Datar o que envelhece no prompt ───
# O agente narrava frame congelado como presente (disse que uma sala de missão
# "segue rodando" quando ela estava parada havia 12 dias e já tinha entregado).
# Causa material: o histórico injetado no prompt NÃO tinha data (o created_at
# vinha do banco e era descartado — 12 dias ficava idêntico a agora), e a linha
# da sala entrava sem estado e sem data, com "ativa" no presente.
# Ligado: cada linha do histórico sai com [dd/mm HH:MM] (fuso do operador) mais
# a idade relativa na 1ª linha e nos saltos grandes; a sala mostra estado REAL
# ("OCIOSA (idle), última atividade há ~12 dias") lido da fonte viva; e o bloco
# de estado de background passa a cobrir salas de missão e jobs despachados,
# não só sessões do Coder. Off = histórico sem data (comportamento legado).
PROMPT_AGING_ENABLED=true

# ─── Gate de referência temporal na saída (MODO OBSERVAÇÃO) ───
# O contrato já proíbe afirmar QUANDO algo aconteceu sem ter conferido, mas a
# regra vazava porque não tinha gatilho: escrever um advérbio não parece uma
# ação. E até então não havia NENHUM passo entre o agente terminar de escrever e
# o operador receber — todo o grounding do Kobe vivia do lado da entrada.
# Ligado, o gate varre a resposta final (regex compilada uma vez no import,
# marcadores em bot/temporal_markers.toml) atrás de afirmação retrospectiva
# ("ontem", "há 3 dias", "semana passada", "desde <data>") e cruza com o rastro
# de ferramentas do turno: se o turno consultou alguma fonte de tempo/estado
# (git log, stat, systemctl, leitura de arquivo, agenda), a afirmação tem lastro;
# se não consultou nenhuma, é confabulação quase certa.
# Medido sobre 1.644 respostas reais: acende em 9,9% dos turnos, custa 140 µs
# por resposta no caminho comum (~0,15 ms de latência esperada por turno).
# NESTA FASE O GATE SÓ LOGA (`temporal_gate ... action=observe`) — não altera a
# resposta, não anexa ressalva, não devolve nada ao agente. Serve pra calibrar em
# produção com risco zero antes de decidir se ele passa a agir.
# Off (default) = caminho de entrega idêntico ao de antes do gate existir.
TEMPORAL_GATE_ENABLED=false

# ─── Plugins (opcionais — só se o plugin estiver instalado) ───
# Plugin atrus (kobe-plugin-atrus): transcrição de URLs via Firecrawl + Groq Whisper.
# - FIRECRAWL_API_KEY: obrigatória se o atrus estiver instalado. https://www.firecrawl.dev
# - HF_TOKEN: obrigatória SE você usar /transcrever-speakers ou /transcrever-leitura-speakers
#   (diarização via pyannote local). Veja docs/runbooks/pyannote-setup.md no repo do plugin.
# FIRECRAWL_API_KEY=fc-...
# HF_TOKEN=hf_...

# AssemblyAI (diarização atrus + fallback Whisper) — pegar em https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=
