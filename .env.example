# ─── Ambiente desta instância ─────────────────────────────────────────────
# "prod" (default) ou "dev". Governa o aviso de ambiente no prompt do agente, o
# prefixo do bank da memória durável e o KOBE_ENV exportado pro subprocesso do
# Claude. AUSENTE = prod = comportamento de sempre; valor desconhecido derruba o
# start com mensagem, em vez de cair calado em produção.
# Deixe comentado em produção. Nas instâncias de desenvolvimento, KOBE_ENV=dev.
# KOBE_ENV=dev

# Compara ESTE .env com um de referência no start e AVISA (WARNING) quais chaves
# faltam de cada lado. Só NOMES de chave são lidos — nenhum valor é comparado,
# impresso ou registrado. Ausente = não roda nada. Nunca derruba o start.
# Rodável à mão: python infra/env_parity.py <referência.env> <alvo.env>
# KOBE_ENV_PARITY_REFERENCE=/caminho/para/o/.env/de/referencia

# Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui
# CSV de user IDs autorizados
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# CSV de chat IDs que esta instância atende. VAZIO ou ausente = atende qualquer
# chat (comportamento de sempre). Preenchido = mensagem de qualquer outro chat é
# ignorada EM SILÊNCIO — falha fechada, e é assim que o bot de desenvolvimento
# fica preso ao grupo de dev. Cuidado: setar isto errado deixa o bot mudo; o
# start emite WARNING dizendo quantos chats estão liberados.
# TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890

# Banco (Postgres)
#
# O Kobe fala Postgres DIRETO, por psycopg — sem PostgREST e sem adaptador no
# meio. Esta e a UNICA coisa que diz onde o banco mora: trocar host, porta,
# banco ou usuario e mudanca aqui + reinicio, nunca mudanca de codigo.
#
#   socket unix local, autenticacao peer (sem senha):
#     DATABASE_URL=postgresql:///kobe
#   por TCP, com usuario e senha:
#     DATABASE_URL=postgresql://usuario:senha@localhost:5432/kobe
#
# Aplique o schema com:  python infra/migrate.py up
# Confira o ambiente com: python infra/compat_gate.py
DATABASE_URL=postgresql:///kobe

# Groq (transcrição)
GROQ_API_KEY=gsk_...

# Anthropic (caso Claude Code use API key em vez de OAuth)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings pro Chat Manager — text-embedding-3-small)
# Obtenha em https://platform.openai.com/api-keys e adicione créditos
# em Billing (mínimo $5 dura anos no uso típico). Custo estimado: ~$0.01/mês.
# Também é o FALLBACK do plugin Monet (geração de imagem via gpt-image-1).
OPENAI_API_KEY=sk-proj-...

# Google Gemini — backend principal do plugin Monet (gemini-2.5-flash-image).
# Obtenha em https://aistudio.google.com/apikey. ~$0.039 por imagem gerada.
GEMINI_API_KEY=AIza...

# Memória de trabalho (Highlander Frente 0): governa a JANELA de memória
# (imediata vs histórico de sessão legado) e a compactação. DEFAULT-ON =
# janela imediata + sem compactação (design Highlander). Off = histórico de
# sessão legado + compactação aos 40 msgs.
WORKING_MEMORY_ENABLED=true

# OS QUATRO PARÂMETROS DA JANELA IMEDIATA. Expostos em 01/09/2026 com os valores
# de SEMPRE como padrão — esta entrega põe os botões no painel e NÃO gira
# nenhum. Mudar os valores é decisão do operador, em fase própria.
#
# ⚠️ QUEM MANDA AQUI NÃO É O RELÓGIO. Medido sobre os 968 turnos reais do
# operador no tópico de maior volume: o PISO de 8 mensagens corta em 87% dos
# turnos, o tempo em 11%, e os dois tetos em 0%. Mexer no tempo enquanto o piso
# está na frente dele quase não muda nada — e o resultado nulo seria lido como
# "esse parâmetro não importa" em vez de "outro está na frente". Antes de
# calibrar, rode:  bot/bin/kobe-memoria diagnostico
#
# E há uma armadilha medida: subir a janela para 6 h SEM subir o teto de token
# faz o TETO virar o limitante em 47% dos turnos — a "janela de 6 horas"
# entregaria 8.000 tokens quase metade das vezes. Os quatro andam juntos.
# WORKING_MEMORY_WINDOW_SECONDS=600   # faixa 30–604800
# WORKING_MEMORY_MIN_COUNT=8          # faixa 1–200  (o que de fato manda hoje)
# WORKING_MEMORY_HARD_CAP=60          # faixa 1–1000
# WORKING_MEMORY_TOKEN_CAP=8000       # 0 desliga o teto de tamanho

# A régua que converte char em token no corte por tamanho. NÃO é política, é
# medida: valor alto não relaxa o orçamento, faz o código CONTAR ERRADO e
# estourar o teto achando que respeitou. Presa em código na faixa 3–5.
# WORKING_MEMORY_CHARS_PER_TOKEN=4

# Núcleo curado global (Highlander Frente 1.2): auto-injeta USER.md + MEMORY.md
# (identidade do operador + fatos duráveis do agente) no topo do prompt, com
# teto e sinal de consolidação. DEFAULT-ON (puro-cômputo, no-op se faltar
# arquivo). Pra desligar: CURATED_CORE_ENABLED=false + restart.
CURATED_CORE_ENABLED=true

# ============================================================================
# BOLETIM QUENTE — o registro de estado presente no prompt (Highlander v3, F4)
# ============================================================================
# O que ele resolve: LUCIEN (F3) já REGISTRA o que foi decidido, o que ficou em
# aberto e o que deixou de valer. Até aqui esse registro só chegava ao agente se
# alguém rodasse `kobe-remember`. O boletim o torna PRESENTE em todo turno.
#
# LATÊNCIA: zero. É um arquivo lido do disco — sem consulta, sem modelo, sem
# rede. O conteúdo já foi escolhido atrás, pelo LUCIEN, numa rodada que ele ia
# fazer de qualquer jeito.
#
# CUSTO: zero. Nenhuma chamada de modelo acontece para montar o boletim: quem
# escolhe as linhas é código (SQL + formatação). O modelo já foi chamado antes,
# quando a afirmação foi escrita.
#
# Desligado, o Kobe volta exatamente ao comportamento anterior — o worker para
# de gerar e o turno para de ler. Os arquivos já escritos são derivados e podem
# ser apagados a qualquer momento (`user-data/lucien/boletins/`).
BOLETIM_ENABLED=true

# O ORÇAMENTO, na unidade em que ele é discutido. 800 e não 1.200, e a diferença
# foi MEDIDA em 31/08/2026: o boletim é escolhido sem saber a pergunta, então
# parte das linhas é de outro assunto por construção. Sobre os 968 turnos reais
# do operador no tópico de maior volume, um bloco de 25 linhas (=1.200 tokens)
# entrega ~24 linhas fora do assunto na mediana — cruzando o marco de ~20 itens
# irrelevantes em que a pesquisa de 27/08 mede a precisão caindo de ~72% p/ ~57%.
# Encher a vaga com linha fora de assunto NÃO é neutro: é pior que não ter bloco.
# Preso em código na faixa 400–1.000; valor fora dela é preso E registrado.
# BOLETIM_TOKEN_BUDGET=800

# A régua que converte o teto de token em corte de char. NÃO é política, é
# medida: um valor alto não relaxa o orçamento, faz o código CONTAR ERRADO e
# estourar o teto achando que respeitou. Conservadora de propósito (português
# com acento tokeniza entre 3,5 e 4,2 chars/token; 3,2 fica abaixo do piso, e o
# erro cai para o lado que não fura). Presa em código na faixa 2,5–5,0.
# BOLETIM_CHARS_POR_TOKEN=3.2

# Tetos SEPARADOS do núcleo curado, um por arquivo (Highlander v3, F0.1 / E10).
# Antes era um teto único de 6.000 dividido entre os dois: o USER.md entrava
# inteiro e o MEMORY.md ficava com a SOBRA — com o USER.md real de 3.367 chars,
# sobravam 2.633 pra memória durável, que é justamente a camada que precisa
# acumular ao longo de anos. Separando, o tamanho da identidade não decide mais
# quanto de memória cabe. Rollback pro comportamento antigo: 4000 / 2000.
CURATED_CORE_USER_LIMIT=4000
CURATED_CORE_MEMORY_LIMIT=6000

# Orçamento (chars) da knowledge/ do tópico dentro do prompt. O que não couber
# vira índice sob demanda (caminho + prévia) e o agente lê com Read — e, desde a
# F0.4 do Highlander v3, o operador é AVISADO no Telegram quando isso acontece,
# em vez de a base sumir do prompt em silêncio. O orçamento é gasto arquivo a
# arquivo, em ordem alfabética: um arquivo grande não derruba mais os pequenos,
# e um `00-indice-curto.md` entra sempre. Rollback: 8000 (o valor de antes).
TOPIC_KNOWLEDGE_INLINE_LIMIT=12000

# Normalizador determinístico de transcrição (Highlander v3, F0.6 / E11).
# Corrige grafia de nome próprio no texto vindo de ÁUDIO, depois do Whisper e
# ANTES de gravar — é o que impede erro de transcrição de virar fato permanente
# na memória durável ("os plugins do Koby ficarão em home, Filipe e Kobi").
# Texto DIGITADO nunca é tocado. Glossário em user-data/transcription-glossary.md
# (sem limite de tamanho, ao contrário das dicas do Whisper, que têm 850 bytes).
# DEFAULT OFF de propósito: ele reescreve o que o operador disse, então só ligue
# depois de rodar `bot/bin/kobe-normalize-report` e ler a lista. Toda
# substituição fica auditada em user-data/transcription-normalizer/<AAAA-MM>.jsonl,
# com o texto original — nada se perde.
TRANSCRIPTION_NORMALIZER_ENABLED=false

# Sinais de grounding baratos (Highlander Frente 1.1): injeta no prompt o que
# muda com o tempo e o agente senão narraria de memória — hoje, há quanto tempo
# foi a última troca neste tópico (anti-confabulação temporal + lembrete de
# retomada). DEFAULT-ON (no-op se não há histórico). Desligar: =false + restart.
GROUNDING_SIGNALS_ENABLED=true

# Gate de estado de background vivo (Highlander v2, P1): a cada turno o código lê
# os arquivos de estado dos trabalhos de background DESTE tópico (Coder/Atrus),
# carimba a idade, e injeta o fato vivo + a regra dura "use isto, não memória" —
# pra o agente nunca narrar status de sala/job de memória (a dor da "sala
# esperando" que já tinha acabado). Read-only, best-effort. DEFAULT-ON (no-op se
# não há trabalho recente). Desligar: =false + restart.
BACKGROUND_STATE_GATE_ENABLED=true

# Memória durável via Hindsight (Highlander Frente 2.3 / v2): retain (escrita) +
# recall (leitura injetada no turno). Exige o serviço Hindsight de pé (ver
# infra/hindsight/). Best-effort: serviço fora = falha rápido e o turno segue.
#
# HINDSIGHT_ENABLED é o MASTER (off = nem retain nem recall). A v2 (F1) separou
# em duas sub-flags com perfis de risco opostos:
#  - HINDSIGHT_RETAIN=true  → segue gravando a memória em silêncio (barato, seguro).
#  - HINDSIGHT_RECALL=false → NÃO injeta o destilado todo turno (de-risca a
#    confabulação que a Auditoria nomeou). Re-ligar (=true) quando a F3 re-fiar o
#    recall pro best-practice e a régua medir que a alucinação caiu.
#
# F0.3 (Highlander v3) acrescentou o NÚMERO ao argumento, e ele é o motivo pelo
# qual o recall segue desligado: medido contra o bank de produção (934 fatos,
# 6.053 ligações), o recall custa 4 a 7 segundos EM TODO TURNO — `budget=mid`,
# que é o configurado, deu 5,1 a 7,2 s — pra entregar ~200 tokens, ou 0,3% do
# prompt. É o pior negócio do turno, e piora sozinho: a mesma consulta num bank
# de 10 fatos leva 0,5 s, e o bank cresce ~30 fatos por dia. O lugar que ele
# ocupa no prompt passa a ser do `topic-briefing` (F4), lido do disco, com
# latência zero. **A gravação continua ligada** — é ela que constrói o que a F3
# e a F4 vão usar. Se este arquivo virar um `.env` real com RECALL=true, é isso
# que está custando os 4 a 7 segundos.
HINDSIGHT_ENABLED=true
HINDSIGHT_RETAIN=true
HINDSIGHT_RECALL=false
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_TIMEOUT_SECONDS=10
HINDSIGHT_RECALL_LIMIT=5

# Teto de espera do `bot/bin/kobe-reflect`, em segundos. É SEPARADO do
# HINDSIGHT_TIMEOUT_SECONDS acima (que vale pro retain/recall) porque o reflect é
# de outra ordem de grandeza: um loop de agente no servidor, 3–5 chamadas de LLM
# mais 2–3 ferramentas. Medido em 29/08/2026 com `claude-haiku-4-5`: 28,1 s na
# chamada fria e 16,9 s na quente — contra um teto que era de 20 s. A fria
# estourava e o helper dizia "sem registro" com o servidor tendo respondido bem.
# 90 s é ~3,2× a pior medição: cobre um retry interno de provider e o acervo
# crescendo. NÃO custa latência a turno nenhum — o reflect só roda quando o
# agente vai buscar, à mão. Se estourar mesmo assim, a saída hoje diz que
# estourou (exit 3), em vez de fingir que o acervo está vazio.
HINDSIGHT_REFLECT_TIMEOUT=90

# Paths (preenchidos pelo instalador)
KOBE_HOME=/home/seu_usuario/projetos/kobe
KOBE_CLAUDE_CWD=/home/seu_usuario/projetos/kobe

# Config
LOG_LEVEL=INFO
CLAUDE_TIMEOUT_SECONDS=300
RECENT_MESSAGES_LIMIT=20
# Quantas mensagens uma sessão ativa pode acumular antes da compactação
# automática (v0.12). Quando atingido, o bot gera summary via Claude,
# arquiva a sessão (status='compacted') e abre uma nova com o summary
# como contexto inicial. Threshold ALTO = prompts maiores, mais tokens.
# Threshold BAIXO = mais transições, mais chamadas de summary.
COMPACT_THRESHOLD_MESSAGES=40

# ─── Despacho de turno pesado em background (cascata de filtros) ───
# Quando true, a ENTRADA do turno classifica se o pedido vai gerar trabalho
# pesado (editar código, varrer repo, análise longa, processar arquivos/URLs)
# e, se for, despacha o `claude -p` em background FORA do lock do tópico —
# o Hal (atendente) fica livre pro próximo pedido na hora. O resultado do
# pesado chega de forma assíncrona (mensagem depois). Quando false, o sistema
# clássico roda intacto (turno foreground, lock segurado o turno inteiro).
# Rollback trivial: flag off + restart. Ver bot/turn_classifier.py e
# docs/runbooks/despacho-turno-pesado.md.
HEAVY_DISPATCH_ENABLED=false
# Retaguarda (teto de tempo): turno que entrou foreground mas estoura estes
# segundos segurando o lock se promove sozinho pra background e libera a
# linha (o claude em voo NÃO recomeça — continua e reporta no fim). É o
# tempo máximo que se aceita ficar preso no pior caso (erro de previsão).
# Baixo (6-8s) = libera rápido mas chuta turnos legítimos longos pro async;
# alto (15-20s) = quase nunca chuta à toa mas erro real custa mais espera.
HEAVY_DISPATCH_PROMOTE_AFTER_SECONDS=12
# Cortes do placar da cascata. score >= HIGH → background na entrada (previsão);
# score <= LOW → foreground; faixa do meio acorda o GPT-4o-mini pra desempatar
# (zona cinza, ~1s, fora da cota do plano Max). Subir HIGH = menos previsões
# de background; subir LOW = mais chamadas ao mini.
HEAVY_DISPATCH_SCORE_HIGH=6
HEAVY_DISPATCH_SCORE_LOW=2
# Teto de tempo do `claude -p` no caminho de despacho pesado (background, tanto
# na previsão quanto na promoção). O turno de bg é o PESADO por definição —
# 300s (default do foreground) corta no meio e a resposta chega truncada
# ("estourei o tempo limite no meio"). Dimensionado pro trabalho pesado real,
# não infinito. Só vale com HEAVY_DISPATCH_ENABLED=true.
HEAVY_DISPATCH_TIMEOUT_SECONDS=1200
# Watchdog de ACK no background: se a run de bg não emitir um `kobe-notify`
# (ack na voz do Hal, que nomeia a ação) dentro destes segundos e ainda
# estiver rodando, o código manda o aviso enlatado como piso garantido — o
# operador nunca fica no escuro mesmo que o Hal não acke a tempo.
HEAVY_DISPATCH_ACK_FALLBACK_SECONDS=20

# ─── Nova arquitetura de borda (4 peças, cada uma atrás de flag, default off) ───
# Transforma a borda de "cano que repassa" em "balcão que atende". Cada flag é
# independente e reversível (flag off + restart volta ao comportamento de hoje).
# Ver CHANGELOG e docs/runbooks/nova-arquitetura-borda.md.
#
# Peça D — Anexos multimodais: aceita QUALQUER arquivo/imagem (paridade com o
# Claude Desktop pro dono), salva o original em uploads/ do tópico (separado do
# knowledge/ curado), cataloga em user-data/uploads-catalogo.md, e correlaciona
# anexo+instrução no mesmo turno (foto passa a funcionar). Off = legado
# (.txt/.md/.pdf/.docx → knowledge/, foto ignorada).
EDGE_UPLOADS_ENABLED=false
#
# Peça A — Message Assembler: agrega mensagens picadas por debounce de silêncio
# num turno só (antes do FIFO). Janelas em ms, tunáveis (calibração no uso):
# QUIET = silêncio base; QUIET_TERMINATED = frase terminada em pontuação dispara
# mais rápido; MAX_WAIT = teto de espera desde o 1º fragmento. Off = 1 msg = 1 turno.
EDGE_ASSEMBLER_ENABLED=false
EDGE_ASSEMBLER_QUIET_MS=2500
EDGE_ASSEMBLER_QUIET_TERMINATED_MS=700
EDGE_ASSEMBLER_MAX_WAIT_MS=9000
#
# Peça C — Resposta limpa: a resposta final vem sem o rascunho pré-ferramenta
# grudado (que aparece efêmero no canal de progresso e some). Off = concatena
# tudo (comportamento de 2026-06-01).
EDGE_CLEAN_RESPONSE_ENABLED=false
#
# Peça B — Liveness Protocol: o ACK das tarefas pesadas vira GARANTIA da borda
# (LIV-ack semântico escrito por modelo barato, gpt-4o-mini) e o aviso enlatado
# de background é aposentado. Off = ack model-driven + enlatado + watchdog de hoje.
EDGE_LIVENESS_ENABLED=false
#
# Ack do Liveness — anti-invenção e modelo trocável (2026-08-20).
# O ack estava inventando plano/arquivo/ferramenta porque o prompt mandava
# "NOMEAR a ação" a um modelo que só vê a mensagem do operador — pedir
# especificidade a quem não tem informação nenhuma produz chute. O prompt foi
# invertido (proíbe fato novo, manda ancorar nas palavras do operador) e ganhou
# um guarda-costas programático, com chave PRÓPRIA:
#
# Rejeita o ack que introduza número, caminho/extensão de arquivo, ou termo
# técnico (arquivo, script, banco, log, VPS, minuto…) que NÃO esteja na
# mensagem do operador — cai no texto fixo, que não inventa nada. Conservador
# de propósito: pode derrubar um ack legítimo de vez em quando (o preço é ver o
# texto fixo). Deixe ligado e avalie; o log mostra o que foi rejeitado.
LIVENESS_ACK_GUARD_ENABLED=false
#
# Modelo que escreve o ack. Default = o de hoje (openai/gpt-4o-mini, fora da
# cota do plano Max). Trocar por Haiku depois é só mudar estas duas linhas +
# restart, sem obra. Provedores: openai | anthropic.
LIVENESS_ACK_PROVIDER=openai
LIVENESS_ACK_MODEL=gpt-4o-mini

# ─── Reações de recebimento (👀 / ✍) ───
# Sinal de "chegou" IMEDIATO e impossível de alucinar: não passa por modelo
# nenhum — é chamada direta à API do Telegram, disparada no instante em que a
# mensagem entra (antes do montador da borda e do classificador). O Telegram
# permite UMA reação por mensagem e a nova SUBSTITUI a anterior, o que
# transforma a própria mensagem num semáforo de estágio:
#     texto/áudio/anexo chega → 👀     transcrição do áudio pronta → ✍
# Efeito colateral desejado: turno que morre calado fica VISÍVEL (o 👀 aparece
# e o silêncio depois dele grita). Off = nenhuma reação (comportamento legado).
TELEGRAM_REACTIONS_ENABLED=false
# Emojis configuráveis: a lista permitida é do Telegram e pode mudar sem aviso
# (🎧 e 👂, por exemplo, NÃO são aceitos — retornam REACTION_INVALID). Vazio
# desliga aquele estágio sem tocar em código. Emoji fora da lista NÃO quebra
# calado: cai no padrão e grava um aviso no log dizendo qual valor foi recusado.
# Atenção à forma exata: o emoji da mão é "✍" (sem o marcador invisível de cor
# que alguns teclados grudam) — o bot normaliza, mas copie do jeito certo.
TELEGRAM_REACTION_RECEIVED=👀
TELEGRAM_REACTION_TRANSCRIBED=✍

# ─── Robustez do banco e garantia de turno ───
# Duas camadas contra a perda SILENCIOSA de mensagem (o operador manda algo
# depois de um tempo parado e simplesmente não vem resposta nenhuma).
#
# Camada 1 — CONEXÃO (específica do driver, isolada em bot/db.py). Conexão
# ociosa é derrubada do outro lado e a primeira requisição depois morre
# ("Server disconnected"). Aqui: recicla o cliente preventivamente depois de
# DB_IDLE_RECYCLE_SECONDS parado, e repete a consulta em erro de TRANSPORTE
# (erro de negócio NÃO é repetido). Off = comportamento legado, sem rede.
DB_RESILIENCE_ENABLED=true
DB_IDLE_RECYCLE_SECONDS=120
# Repetir também ESCRITAS. Trade-off: se o servidor gravou mas a resposta se
# perdeu, a repetição duplica uma linha (remotíssimo — a conexão estava morta
# antes do pedido sair). Uma linha duplicada é menos grave que uma mensagem
# perdida; false desliga só isso e mantém o retry de leitura.
DB_RETRY_WRITES=true
#
# Camada 2 — GARANTIA (agnóstica de banco: vale pra Supabase, pro Postgres
# local e pro que vier depois). Turno que levanta exceção → a mensagem é
# gravada em user-data/pending-turns/, uma retentativa automática roda quando
# é seguro (erro de transporte E antes de o turno ter gravado qualquer coisa),
# e o operador é AVISADO se não der. No arranque, o que sobrou é REPORTADO —
# não reprocessado (mensagem de horas atrás não deve virar resposta do nada).
# Off = a exceção volta a subir como antes.
TURN_GUARANTEE_ENABLED=true

# ─── Datar o que envelhece no prompt ───
# O agente narrava frame congelado como presente (disse que uma sala de missão
# "segue rodando" quando ela estava parada havia 12 dias e já tinha entregado).
# Causa material: o histórico injetado no prompt NÃO tinha data (o created_at
# vinha do banco e era descartado — 12 dias ficava idêntico a agora), e a linha
# da sala entrava sem estado e sem data, com "ativa" no presente.
# Ligado: cada linha do histórico sai com [dd/mm HH:MM] (fuso do operador) mais
# a idade relativa na 1ª linha e nos saltos grandes; a sala mostra estado REAL
# ("OCIOSA (idle), última atividade há ~12 dias") lido da fonte viva; e o bloco
# de estado de background passa a cobrir salas de missão e jobs despachados,
# não só sessões do Coder. Off = histórico sem data (comportamento legado).
PROMPT_AGING_ENABLED=true

# ─── Gate de referência temporal na saída (MODO OBSERVAÇÃO) ───
# O contrato já proíbe afirmar QUANDO algo aconteceu sem ter conferido, mas a
# regra vazava porque não tinha gatilho: escrever um advérbio não parece uma
# ação. E até então não havia NENHUM passo entre o agente terminar de escrever e
# o operador receber — todo o grounding do Kobe vivia do lado da entrada.
# Ligado, o gate varre a resposta final (regex compilada uma vez no import,
# marcadores em bot/temporal_markers.toml) atrás de afirmação retrospectiva
# ("ontem", "há 3 dias", "semana passada", "desde <data>") e cruza com o rastro
# de ferramentas do turno: se o turno consultou alguma fonte de tempo/estado
# (git log, stat, systemctl, leitura de arquivo, agenda), a afirmação tem lastro;
# se não consultou nenhuma, é confabulação quase certa.
# Medido sobre 1.644 respostas reais: acende em 9,9% dos turnos, custa 140 µs
# por resposta no caminho comum (~0,15 ms de latência esperada por turno).
# NESTA FASE O GATE SÓ LOGA (`temporal_gate ... action=observe`) — não altera a
# resposta, não anexa ressalva, não devolve nada ao agente. Serve pra calibrar em
# produção com risco zero antes de decidir se ele passa a agir.
# Off (default) = caminho de entrega idêntico ao de antes do gate existir.
TEMPORAL_GATE_ENABLED=false

# ─── Highlander v3, F1 — salvaguarda do bruto + catálogo de desenvolvimento ───
#
# Duas peças, duas chaves, e AS DUAS NASCEM DESLIGADAS — de propósito. Elas são o
# rollback da fase, e o default off é o que impede o pior modo de falha da
# implantação: o código novo dos dispatchers chegar num ambiente onde a migration
# 006 ainda não foi aplicada e, aí sim, derrubar TODA abertura de sala.
#
# A ORDEM DE ATIVAÇÃO IMPORTA:
#   1. aplicar a migration 006 (`python infra/migrate.py up`)
#   2. só então ligar as chaves e reiniciar o bot e o Keyko
# A ordem inversa quebra.

# O COLETOR DE TRANSCRIPTS.
# O Claude Code guarda, por sala, um registro riquíssimo do trabalho — o pedido, o
# raciocínio, cada ferramenta chamada, cada resultado — e o APAGA EM 30 DIAS. Este
# coletor copia o que houver de novo em cada sala, por deslocamento de byte, sem
# travar nada e sem nunca corromper. A cópia é crua e íntegra: nenhum bloco é
# peneirado, nem `thinking`.
#
# ⚠️ ORIGEM COMPARTILHADA: `~/.claude/projects` é do HOST e é UM SÓ. Se o coletor
# de desenvolvimento e o de produção rodarem ao mesmo tempo, os dois colhem os
# MESMOS arquivos para destinos diferentes — duas verdades e o dobro do disco.
# Ligue em UM ambiente só. Quem colhe de verdade é a produção.
TRANSCRIPT_COLLECTOR_ENABLED=false

# O CATÁLOGO DE DESENVOLVIMENTO.
# Ligado, `--system` e `--subsystem` passam a ser obrigatórios nos dois
# dispatchers (Coder e Mission Control), e a sala NÃO nasce sem declaração válida.
# Desligado, os dispatchers voltam a aceitar abertura sem declaração, exatamente
# como antes da F1.
WORK_CATALOG_ENABLED=false

# Onde colher e para onde. Os defaults servem a instalação padrão.
# TRANSCRIPT_SOURCE_ROOT=~/.claude/projects
# TRANSCRIPT_DEST=$KOBE_HOME/user-data/transcripts

# A MARCA DO RELÓGIO. O coletor roda por tempo, e um agendador que para não
# produz erro — produz SILÊNCIO, indistinguível de "não havia nada novo". O
# coletor registra a data da última coleta bem-sucedida e passa a se declarar
# `STALE` acima deste limite, em horas. `kobe-collect-transcripts status` mostra.
# TRANSCRIPT_STALE_HOURS=48

# Cadência da coleta, em segundos (default: diária). Reiniciar o Keyko também
# dispara uma coleta — o primeiro tick de toda fonte é imediato —, então a
# cadência real é "diária, ou quando o daemon subir". Piso de 60 s.
# TRANSCRIPT_COLLECT_INTERVAL_S=86400

# PARA ONDE MANDAR O AVISO de coletor envelhecido. Sem isto, o aviso fica só no
# log — e é assim de propósito: uma mensagem de saúde do sistema caindo num
# tópico qualquer é pior que não mandar mensagem nenhuma. A visibilidade não
# depende só daqui; o dispatcher do Coder também devolve o aviso a cada abertura
# de sala, por um caminho que não depende do agendador que falhou.
# TRANSCRIPT_ALERT_CHAT_ID=
# TRANSCRIPT_ALERT_THREAD_ID=

# Teto de espera pra abrir conexão com o banco na hora de registrar uma sala.
# Pequeno de propósito: quem espera é um operador que acabou de pedir uma sala,
# e se o banco está fora a resposta certa é "falhou, e por isto" em segundos.
# WORK_CATALOG_CONNECT_TIMEOUT=5

# Gancho para a F3 (destilação com julgamento). NÃO é usado na F1 — o dossiê da
# F1 é determinístico, montado a partir do que a sala de fato disse e fez.
# TRANSCRIPT_DOSSIER_LLM=false

# ─── Plugins (opcionais — só se o plugin estiver instalado) ───
# Plugin atrus (kobe-plugin-atrus): transcrição de URLs via Firecrawl + Groq Whisper.
# - FIRECRAWL_API_KEY: obrigatória se o atrus estiver instalado. https://www.firecrawl.dev
# - HF_TOKEN: obrigatória SE você usar /transcrever-speakers ou /transcrever-leitura-speakers
#   (diarização via pyannote local). Veja docs/runbooks/pyannote-setup.md no repo do plugin.
# FIRECRAWL_API_KEY=fc-...
# HF_TOKEN=hf_...

# AssemblyAI (diarização atrus + fallback Whisper) — pegar em https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=

# ============================================================================
# BUSCA SOBRE A CONVERSA — o índice de `kobe-remember` (Highlander v3, F2)
# ============================================================================
# O que ele resolve: hoje toda pergunta sobre o passado é respondida de memória,
# e é daí que sai o achismo. Com o índice, `kobe-remember "<assunto>"` devolve as
# FALAS LITERAIS com data e número da mensagem — e, quando não há registro, diz
# que não há em vez de inventar.
#
# DESLIGADO, o que continua funcionando: a busca por PALAVRA e a busca LITERAL.
# As duas não dependem de chave nenhuma — `messages.search_tsv` é coluna gerada
# pelo Postgres e os índices ficam prontos no próprio INSERT. O que a chave liga
# é a busca por SENTIDO (a que acha paráfrase), que precisa de embedding.
#
# ROLLBACK: desligar. `message_chunks` fica inerte, nada é apagado, e o comando
# passa a dizer em toda saída que a perna de sentido está fora — para que um
# "não achei" parcial nunca passe por ausência confirmada.
SEARCH_INDEX_ENABLED=false

# Cadência do indexador, em segundos. É o atraso máximo entre uma mensagem ser
# gravada e ficar buscável POR SENTIDO. Piso de 10 s.
# SEARCH_INDEX_INTERVAL_S=60

# O modelo de embedding. O default é `text-embedding-3-small` (1536d), e ele tem
# que casar com a dimensão da coluna criada pela migration 007. Trocar aqui SEM
# reindexar mistura dois espaços vetoriais no mesmo índice — e o sintoma disso
# não é erro, é resposta errada com nota plausível.
# SEARCH_EMBED_MODEL=text-embedding-3-small
# SEARCH_EMBED_TIMEOUT=60

# OS PISOS DO "NÃO TENHO REGISTRO". São a trava anti-invenção, e saem daqui em
# vez de literais no código justamente porque envelhecem conforme o acervo
# cresce. `bot/search/calibrar.py` remede os dois e reimprime a tabela.
#
# SEARCH_PISO_COS: similaridade mínima para a busca por sentido afirmar que
# ACHOU. Medido sobre 16 perguntas (8 com resposta, 8 sobre assuntos que nunca
# existiram): com resposta 0,598–0,693; sem resposta 0,428–0,536. Qualquer valor
# entre 0,537 e 0,597 acerta as 16; 0,57 é o meio.
# SEARCH_PISO_COS=0.57
#
# SEARCH_DF_MAX: acima desta fração do acervo, um radical é considerado banal e
# sai da consulta. "a gente" está em 16% das mensagens e "sobre" em 14% — são
# elas que faziam uma pergunta sobre assunto inexistente devolver 30 resultados
# com nota de pergunta legítima.
# SEARCH_DF_MAX=0.05

# ============================================================================
# LUCIEN — o registro de estado (Highlander v3, F3)
# ============================================================================
# O que ele resolve: hoje a memória do Kobe registra todo PEDIDO que você já fez
# e nunca registra que o pedido foi RESPONDIDO. Por isso um assunto retomado
# volta com as suas perguntas de julho em vez das decisões de julho. LUCIEN lê o
# que entrou de novo, fora do caminho do turno, e responde duas coisas: que
# afirmações duráveis isto estabelece, e quais das que já valiam isto contradiz,
# fecha ou abandona.
#
# O RISCO, DITO EM VOZ ALTA: esta é a única peça do Kobe em que um modelo
# escreve estado que o agente depois serve como se fosse conhecido. As
# mitigações estão no código e não dependem de ninguém lembrar — origem
# obrigatória com chave estrangeira, o `#número` citado tendo que estar no lote
# que foi mostrado ao modelo, superação sempre reversível com a imagem anterior
# guardada, e fato vindo de áudio entrando com confiança menor.
#
# DESLIGADO, o que continua funcionando: TUDO o que existe hoje. O registro é
# consultado sob demanda (pelo `kobe-remember`), nunca injetado no prompt do
# turno — então desligar não muda um byte de nenhuma conversa. As cinco tabelas
# ficam inertes e nada é apagado.
#
# CUSTO: cota, não dinheiro. LUCIEN fala com o modelo pela sua assinatura, pelo
# mesmo caminho que o Keyko já usa. Medido em 30/08/2026: 13.154 tokens de
# contexto por chamada (43.039 antes de enxugar ferramentas e MCP), e chamadas
# seguidas reaproveitam o cache do prefixo.
#
# NASCE LIGADA, decisão do operador em 30/08/2026 — e a razão de isso ser seguro
# numa instalação nova é que instalação nova não tem passado: o registro só
# custa quando há conversa para ler, e ele lê por acúmulo, com teto por hora. A
# conta cara é a RECONSTRUÇÃO do histórico (`kobe-lucien reconstruir`), que é um
# comando à parte, roda à mão, e nunca é disparada por esta chave. Para desligar,
# ponha `false` aqui e reinicie o Keyko: a fonte deixa de ser registrada, as
# tabelas ficam inertes e nada do que já foi escrito é apagado.
LUCIEN_ENABLED=true

# QUANDO UM LOTE É DEVIDO — dois gatilhos, e o segundo não é redundante: sem
# ele, um tópico de pouca conversa nunca acumularia o mínimo e ficaria para
# sempre sem estado.
# LUCIEN_BATCH_MIN=12          # mensagens novas que disparam por acúmulo
# LUCIEN_MAX_AGE_S=21600       # idade da pendente mais antiga que dispara (6h)

# TETOS DO LOTE. São dois porque o que estoura contexto é caractere, não linha:
# 40 mensagens curtas cabem folgadas, 40 mensagens longas do agente não.
# LUCIEN_BATCH_MAX=40
# LUCIEN_BATCH_MAX_CHARS=60000
# LUCIEN_ESTADO_MAX=60         # afirmações vigentes mostradas ao modelo

# TETO SOBRE O QUE O MODELO DEVOLVE — e ele NÃO descarta, ele manda DIVIDIR.
#
# Batendo no teto, a rodada não grava nada, o cursor não anda, e o lote é partido
# ao meio. Cada metade vira uma rodada própria. O comportamento anterior — cortar
# as últimas da lista — é o pior possível numa trava: ela não escolhe, e o que se
# perde é invisível. Medido no piloto de 30/08/2026: o teto (então 8) bateu em
# 5 de 5 lotes e levou 20 afirmações embora, escolhidas por posição.
#
# 20 tem folga sobre os 9–15 que o piloto mediu, sem tornar a trava inerte.
# LUCIEN_MAX_CLAIMS_POR_LOTE=20

# O PISO DA DIVISÃO. Se nem com 5 mensagens o modelo couber no teto, não é lote
# grande: é degeneração. Aí grava-se o que cabe e a recusa vira BARULHENTA (vai
# ao operador, via LUCIEN_ALERT_CHAT_ID). É o único caminho em que algo se perde.
# LUCIEN_LOTE_PISO=5
# LUCIEN_DIVISOES_MAX=3

# PARA ONDE MANDAR O AVISO de degeneração. Sem isto ele fica só no log, e é assim
# de propósito: uma mensagem de saúde do sistema caindo num tópico qualquer é
# pior que não mandar mensagem nenhuma. Mesma regra do coletor da F1.
# LUCIEN_ALERT_CHAT_ID=
# LUCIEN_ALERT_THREAD_ID=

# O PISO DO "NÃO TENHO ESTADO SOBRE ISSO". NÃO é o mesmo da busca de evidência
# (SEARCH_PISO_COS), e a diferença foi medida: aquele foi calibrado sobre
# `messages`, que é texto longo e ruidoso; afirmações são curtas e densas e
# separam muito melhor. Sobre 40 afirmações, 8 perguntas com resposta e 8 sobre
# assuntos inexistentes: com resposta 0,570–0,773, sem resposta 0,253–0,289 —
# folga de +0,281, contra +0,061 da evidência. O default fica no meio dos dois.
# LUCIEN_PISO_COS=0.43

# COTA. LUCIEN não tem pressa: um pico de conversa não pode virar um pico de
# chamadas de modelo.
# LUCIEN_MAX_RUNS_HORA=6
# LUCIEN_INTERVAL_S=300        # de quanto em quanto tempo se PERGUNTA se há lote
# LUCIEN_TIMEOUT_S=180

# OS MODELOS. Vazio = o modelo padrão da CLI — o Kobe não fixa modelo em código.
# Decisão do operador em 30/08/2026: `sonnet` na reconstrução, que é onde está o
# volume (~145 chamadas sobre todo o histórico), e o padrão no incremental, que
# é de baixo volume e onde a qualidade do julgamento importa mais.
# LUCIEN_MODEL=
# LUCIEN_MODEL_RECONSTRUCAO=sonnet
