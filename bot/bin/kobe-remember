#!/usr/bin/env python3
"""kobe-remember — as FALAS LITERAIS do passado, citadas com data e número.

AS TRÊS CAMADAS (v2, Highlander v3 F3)
--------------------------------------
A saída vem em três blocos visualmente separados, e a separação é a informação:

    ESTADO      o que VALE hoje — curado por LUCIEN, com origem e vigência
    EVIDÊNCIA   o que foi DITO — as falas literais, citadas (é a v1, intacta)
    PISTAS      o destilado do Hindsight — só quando o estado está magro

São graus de confiança diferentes. A evidência é verdade bruta: aquilo foi dito,
ponto. O estado é **julgamento** — um modelo leu a evidência e concluiu. Servir
os dois no mesmo bloco faria o julgamento passar por transcrição, e é exatamente
essa indistinção que a fase inteira existe para matar.

**O veredito continua sendo da EVIDÊNCIA.** ESTADO não vota nele — nem para
transformar um "não achei" em "achei", nem o contrário. A única concessão é de
TEXTO: quando há estado e a evidência não achou a fala, o carimbo diz isso, em
vez de afirmar que não há nada sobre o assunto (o que seria falso).

O QUE ELE É, E O QUE ELE NÃO É
-------------------------------
É o caminho para responder *"o que a gente decidiu sobre X?"* com o que foi
realmente dito, em vez de com memória. Ele devolve **trecho literal + data +
`#número da mensagem`** — os três juntos, para que o operador possa conferir.

Ele NÃO é o `kobe-reflect`. Os dois se completam e não se substituem:

    kobe-reflect   → o DESTILADO do Hindsight: fatos consolidados, sintetizados.
    kobe-remember  → as FALAS BRUTAS: o que foi dito, palavra por palavra.

Pergunta sobre uma decisão? Os dois ajudam. Pergunta do tipo *"quais foram as
palavras dele?"*, *"eu já tinha pedido isso?"*, *"mostra onde a gente falou
disso"* — só este.

OS QUATRO DESFECHOS, E POR QUE O QUARTO EXISTE
-----------------------------------------------
    exit 0 + trechos citados        → ACHOU
    exit 0 + MENÇÃO LITERAL         → a palavra aparece, mas nada responde a
                                      pergunta. NÃO costure as menções numa
                                      resposta.
    exit 0 + SEM REGISTRO           → procurou, e não há. Pode dizer "não tenho
                                      registro disso".
    exit 3 + FALHA DO INSTRUMENTO   → NÃO SE SABE. Banco fora, ou o serviço de
                                      embedding não respondeu. **Nunca** relate
                                      isto como ausência de registro.

O quarto não é zelo excessivo: este sistema já transformou falha de instrumento
em *"não há registro disso"* **duas vezes** — na F0.5-B (os embeddings tomando
401 e o `reflect` respondendo vazio, com latência ótima) e no `kobe-reflect` em
29/08 (o cliente desistindo aos 20 s de um servidor que respondia aos 28 s). Os
dois eram indistinguíveis de acervo vazio na tela.

ESCOPO: ATRAVESSA OS TÓPICOS, ROTULANDO
----------------------------------------
Decisão E5 do briefing: *"injeção automática respeita a parede entre tópicos;
recuperação sob demanda ATRAVESSA, sempre rotulando de onde veio"*. Por isso
cada trecho sai com o nome do tópico. `--topico` restringe ao tópico atual.

USO
---
    kobe-remember "arquitetura de borda"
    kobe-remember "compat_gate" --topico
    kobe-remember "o que decidimos sobre deploy" --desde 2026-06-01 --limite 5
    kobe-remember --ver 3059          # abre a vizinhança da mensagem #3059
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

_RAIZ = Path(__file__).resolve().parent.parent.parent
if str(_RAIZ) not in sys.path:
    sys.path.insert(0, str(_RAIZ))

# O interpretador certo — ver `bot/bin/_venv.py`. Sem lista de dependências: a
# pergunta é "já estou no venv do projeto?", não "falta algum módulo?". Este
# helper já teve o bug da lista incompleta em 27/08/2026 (a lista dizia
# `psycopg`, faltava `httpx`/`openai`).
_HELPER_DIR = Path(__file__).resolve().parent
if str(_HELPER_DIR) not in sys.path:
    sys.path.insert(0, str(_HELPER_DIR))
from _venv import ensure as _ensure_venv  # noqa: E402

_ensure_venv(__file__)


LARGURA = 88


def _cortar(texto: str, limite: int = 420) -> str:
    t = " ".join((texto or "").split())
    return t if len(t) <= limite else t[: limite - 1].rstrip() + "…"


# A ponte fixa `TimeZone=UTC` na conexão de propósito (vide `bot/db.py`), então
# o carimbo chega em UTC. Citar em UTC para um operador que vive em Brasília faz
# a citação **não bater com o que ele viu na tela** — apontado por ele mesmo
# durante a bateria. A conversão é de exibição; o dado guardado não muda.
_FUSO = "America/Sao_Paulo"


def _data(iso: str) -> str:
    """`13/07/2026 15:22` — no fuso do operador, a partir do carimbo UTC."""
    from datetime import datetime
    from zoneinfo import ZoneInfo

    bruto = str(iso or "").strip()
    if not bruto:
        return ""
    try:
        dt = datetime.fromisoformat(bruto.replace(" ", "T"))
    except ValueError:
        return bruto[:16]
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=ZoneInfo("UTC"))
    return dt.astimezone(ZoneInfo(_FUSO)).strftime("%d/%m/%Y %H:%M")


def _topico_atual(db):
    """O `topics.id` do tópico de onde a chamada veio, ou `None`.

    Sem `KOBE_CHAT_ID` no ambiente não há tópico atual — é o caso de rodar o
    comando à mão num terminal. Aí `--topico` não tem o que restringir, e isso
    é dito em voz alta em vez de virar um filtro vazio que devolve nada.
    """
    chat = os.environ.get("KOBE_CHAT_ID")
    if not chat:
        return None
    thread = os.environ.get("KOBE_THREAD_ID") or None
    try:
        chat_id = int(chat)
        thread_id = int(thread) if thread not in (None, "") else 0
    except ValueError:
        return None
    linha = db.one(
        "SELECT id FROM topics WHERE telegram_chat_id = %s AND telegram_thread_id = %s",
        (chat_id, thread_id),
    )
    return linha["id"] if linha else None


_ROTULO = {
    "decision": "DECIDIDO",
    "open": "ABERTO",
    "preference": "PREFERÊNCIA",
    "fact": "FATO",
}
_ROTULO_ENCERRADA = {
    "superada": "SUPERADA",
    "fechada": "FECHADA",
    "abandonada": "ABANDONADO",
}


# A confiança e o canal, separados — e a separação foi o conserto de 30/08/2026.
#
# Antes, `confidence` media o CANAL (`baixa` para tudo que vinha de áudio) e a
# exibição era binária: áudio ganhava carimbo de suspeita, texto não ganhava
# nada. Como o operador usa voz como canal principal, "baixa" saía em 27 de 40
# linhas do piloto — e um sinal em dois terços das linhas não distingue nada.
#
# Agora `confidence` mede CORROBORAÇÃO e os três níveis aparecem, inclusive o
# `alta` (que antes era código morto). O canal vira metadado neutro, ao lado,
# porque continua sendo informação útil — só não é mais um julgamento.
_SELO_CONF = {
    "alta": "corroborada",
    "media": "origem única",
    "baixa": "⚠ trecho de origem ambíguo",
}


def _selo(a) -> str:
    partes = [_SELO_CONF.get(a.confidence, a.confidence)]
    if getattr(a, "origem_audio", False):
        partes.append("origem em áudio")
    return " · " + " · ".join(partes)


def _dia(iso: str) -> str:
    """Só a data. A hora não ajuda a decidir se algo ainda vale, e a linha do
    ESTADO precisa caber de olhada."""
    return _data(iso).split(" ")[0]


def _imprimir_estado(e) -> None:
    """O bloco ESTADO. Cada linha carrega a ORIGEM — é o que a torna conferível,
    e é a mitigação número um do risco desta fase."""
    print("═" * LARGURA)
    print("ESTADO — o que vale hoje (curado por LUCIEN)")
    print("═" * LARGURA)
    print()
    for a in e.vigentes:
        rotulo = _ROTULO.get(a.kind, a.kind.upper())
        print(f"  {rotulo:<12} {_dia(a.valid_from)}  {a.statement}")
        print(f"  {'':<12} ← #{a.source_seq} · {a.topico}{_selo(a)}")
        print()
    if e.superadas:
        print("  ── o que NÃO vale mais ──")
        print()
        for a in e.superadas:
            rotulo = _ROTULO_ENCERRADA.get(a.status, a.status.upper())
            print(f"  {rotulo:<12} {_dia(a.valid_from)}  {a.statement}")
            if a.substituta:
                print(f"  {'':<12} → substituída em {_dia(a.substituta_data or '')} "
                      f"por: {_cortar(a.substituta, 150)}")
                print(f"  {'':<12}   (#{a.substituta_seq})")
            else:
                fim = _dia(a.valid_to or "")
                print(f"  {'':<12} → encerrada em {fim} · ← #{a.source_seq}")
            print()
    print("  ⚠️  ESTADO é curado por um MODELO, não é fala literal. Cada linha traz")
    print("     a origem: confira com `kobe-remember --ver <número>` antes de")
    print("     afirmar ao operador que algo foi decidido.")
    print()


def _imprimir_achados(r) -> None:
    for a in r.achados:
        pernas = []
        if "sentido" in a.pernas and a.cos is not None:
            pernas.append(f"sentido {a.cos:.3f}")
        if "palavra" in a.pernas:
            pernas.append("palavra")
        if a.literal:
            pernas.append("literal")
        quem = "operador" if a.role == "user" else ("agente" if a.role == "assistant" else a.role)
        print(f"#{a.seq} · {_data(a.created_at)} · {quem} · tópico {a.topico}")
        print(f'   "{_cortar(a.corpo)}"')
        print(f"   ({' · '.join(pernas)})")
        print()


def _rodape(r) -> None:
    """O que o agente precisa saber para não afirmar mais do que foi apurado."""
    if not r.sentido_ativo:
        print(
            "⚠️  A busca por SENTIDO está fora — "
            f"{r.motivo_sentido_fora}\n"
            "    Isto rodou só com as duas buscas por palavra. Um 'não achei' "
            "aqui é PARCIAL:\n"
            "    diga isso ao operador, não o apresente como ausência confirmada."
        )
    if r.ecos_descartados:
        print(
            f"ℹ️  descartei {r.ecos_descartados} resultado(s) que eram a PRÓPRIA "
            "pergunta (versões dela já gravadas no histórico) — uma pergunta "
            "repetida se parece consigo mesma e ocuparia as vagas dos resultados "
            "de verdade."
        )
    if r.ignoradas_pelo_eco:
        print(
            f"ℹ️  ignorei {r.ignoradas_pelo_eco} mensagem(ns) dos últimos "
            f"{int(r.janela_eco_s)}s — inclusive a pergunta que originou este "
            "turno, que entra no histórico antes da busca rodar. Use `--agora` "
            "para incluí-las."
        )
    pend = r.pendencia or {}
    atraso = int(pend.get("trechos_sem_vetor") or 0) + int(
        pend.get("mensagens_sem_trecho") or 0
    )
    if atraso:
        idade = pend.get("idade_segundos") or 0
        print(
            f"ℹ️  {atraso} trecho(s) ainda sem vetor (o mais antigo há "
            f"{int(idade // 60)} min). Mensagens muito recentes podem não "
            "aparecer na busca por sentido ainda."
        )


def _ver(db, seq: int, janela: int) -> int:
    """A vizinhança de uma mensagem. É o que fecha o ciclo de conferência:
    o operador lê a citação, pede o número, e vê o contexto em volta."""
    linhas = db.query(
        "SELECT m.seq, m.role, m.created_at, m.content,"
        "       COALESCE(t.current_name, '?') AS topico"
        "  FROM messages m LEFT JOIN topics t ON t.id = m.topic_id"
        " WHERE m.seq BETWEEN %s AND %s ORDER BY m.seq",
        (seq - janela, seq + janela),
    )
    if not linhas:
        print(f"não existe mensagem #{seq}.")
        return 0
    for l in linhas:
        marca = "▸" if l["seq"] == seq else " "
        quem = "operador" if l["role"] == "user" else (
            "agente" if l["role"] == "assistant" else l["role"]
        )
        print(f"{marca} #{l['seq']} · {_data(l['created_at'])} · {quem} · {l['topico']}")
        print(f"    {_cortar(l['content'], 600)}")
        print()
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="kobe-remember",
        description="As falas literais do passado, citadas com data e número.",
    )
    ap.add_argument("assunto", nargs="*", help="o que procurar")
    ap.add_argument("--limite", type=int, default=8, help="quantos trechos (padrão 8)")
    ap.add_argument(
        "--topico",
        action="store_true",
        help="restringe ao tópico atual (o padrão atravessa todos, rotulando)",
    )
    ap.add_argument(
        "--agora",
        action="store_true",
        help="inclui os últimos segundos (por padrão a janela de eco os ignora — "
        "a pergunta que você acabou de fazer não é registro do passado)",
    )
    ap.add_argument("--desde", default=None, help="só a partir desta data (ISO)")
    ap.add_argument("--ate", default=None, help="só até esta data (ISO)")
    ap.add_argument("--ver", type=int, default=None, help="abre a vizinhança de uma mensagem")
    ap.add_argument("--janela", type=int, default=2, help="quantas mensagens em volta do --ver")
    ap.add_argument("--json", action="store_true", help="saída em JSON")
    ap.add_argument("--estado", action="store_true",
                    help="SÓ a camada de estado (o que vale hoje)")
    ap.add_argument("--sem-estado", action="store_true",
                    help="pula a camada de estado (a saída da v1, exata)")
    ap.add_argument("--sem-pistas", action="store_true",
                    help="não consulta o Hindsight nem quando o estado está magro")
    args = ap.parse_args(argv)

    assunto = " ".join(args.assunto).strip()
    if not assunto and args.ver is None:
        print('Uso: kobe-remember "<assunto>"   |   kobe-remember --ver <n>', file=sys.stderr)
        return 2

    from bot.config import load_config
    from bot.db import build_client
    from bot.search import query as q

    try:
        db = build_client(load_config())
    except Exception as exc:  # noqa: BLE001
        # Nem chegou ao acervo. Dizer "sem registro" aqui seria a mentira que
        # este comando existe pra não contar.
        print(f"kobe-remember: {type(exc).__name__}: {exc}", file=sys.stderr)
        print(
            "(FALHA DO INSTRUMENTO — não deu pra abrir o banco. NÃO conclua que "
            "não há registro: a busca não chegou a acontecer.)"
        )
        return 3

    if args.ver is not None:
        return _ver(db, args.ver, max(0, args.janela))

    topic_id = _topico_atual(db) if args.topico else None
    if args.topico and topic_id is None:
        print(
            "(--topico pedido, mas não há tópico atual no ambiente "
            "(KOBE_CHAT_ID). Busquei em TODOS os tópicos.)"
        )

    r = q.buscar(
        db,
        assunto,
        topic_id=topic_id,
        desde=args.desde,
        ate=args.ate,
        janela_eco=0.0 if args.agora else q.JANELA_ECO_S,
        limite=max(1, args.limite),
    )

    # ── A camada de ESTADO ────────────────────────────────────────────────
    # Depois da evidência de propósito: os `seq` que ela achou viram a perna
    # mais precisa da busca de estado (uma afirmação nascida de uma mensagem que
    # a evidência trouxe responde à pergunta por construção).
    #
    # Falhar aqui NÃO derruba o comando. Um `kobe-remember` quebrado é pior que
    # um sem ESTADO — e a produção, até a migration 008 entrar, cai exatamente
    # neste caminho.
    estado = None
    if not args.sem_estado:
        try:
            from bot.lucien import consulta

            # Os `seq` da evidência só entram quando ela AFIRMA relevância.
            # Com `MENÇÃO LITERAL` ela diz o contrário — "a palavra aparece e eu
            # não consigo confirmar que responde" —, e deixar esses trechos
            # elegerem estado transformaria uma incerteza declarada numa
            # afirmação. Achado testando: "campeonato de xadrez" (assunto que
            # nunca existiu) dava MENÇÃO LITERAL e trazia, pelo caminho da
            # origem, uma preferência sobre anexo no Telegram.
            seqs = [a.seq for a in r.achados] if r.veredito == "ACHOU" else []
            estado = consulta.buscar_estado(
                db, assunto, topic_id=topic_id,
                seqs_da_evidencia=seqs,
                limite=max(1, args.limite),
            )
        except Exception as exc:  # noqa: BLE001
            print(f"⚠️  a camada de ESTADO falhou ({type(exc).__name__}: {exc}) — "
                  "seguindo só com a EVIDÊNCIA.")
            estado = None

    if args.estado:
        if estado is None or not estado.disponivel:
            motivo = estado.erro if estado else "camada indisponível"
            print(f"ESTADO indisponível — {motivo}")
            return 0
        if estado.vazio:
            print("ESTADO — nada registrado sobre isso ainda.")
            print()
            print("Não é o mesmo que 'não há registro': LUCIEN pode ainda não ter")
            print("lido esta parte da conversa. Rode sem `--estado` para ver a")
            print("EVIDÊNCIA, que é a fala literal e não depende dele.")
            return 0
        _imprimir_estado(estado)
        return 0

    if args.json:
        import json
        from dataclasses import asdict

        saida = {"evidencia": asdict(r)}
        if estado is not None:
            saida["estado"] = asdict(estado)
        print(json.dumps(saida, ensure_ascii=False, indent=2, default=str))
        return 3 if r.veredito == "FALHA" else 0

    tem_estado = bool(estado and estado.disponivel and not estado.vazio)
    if tem_estado:
        _imprimir_estado(estado)

    if r.veredito == "FALHA":
        print(f"kobe-remember: {r.erro}", file=sys.stderr)
        print(
            f"(FALHA DO INSTRUMENTO — {r.erro}\n"
            "NÃO conclua que não há registro: a busca não chegou a ser "
            "respondida. Diga ao operador que a consulta ao histórico falhou, "
            "e por quê.)"
        )
        return 3

    if r.veredito == "SEM_REGISTRO" and tem_estado:
        # O texto padrão diria *"não há NADA sobre isso"* — e com estado
        # registrado isso é FALSO. A camada de evidência não achou a FALA; o
        # assunto existe. Dizer a primeira coisa no lugar da segunda seria a
        # mesma mentira que este comando existe para não contar.
        print("═" * LARGURA)
        print("EVIDÊNCIA — a fala literal")
        print("═" * LARGURA)
        print()
        print(
            "SEM REGISTRO na fala literal — MAS HÁ ESTADO REGISTRADO (acima).\n"
            "\n"
            "O que isto significa: LUCIEN registrou afirmações sobre este assunto,\n"
            "mas a busca não localizou a conversa de origem com ESTAS palavras.\n"
            "  · responda pelo ESTADO, citando o `#número` que cada linha traz;\n"
            "  · diga que não localizou a fala com essas palavras;\n"
            "  · NÃO diga que não há registro — há, e está logo acima.\n"
            "Para ver a conversa de origem: `kobe-remember --ver <número>`."
        )
        _rodape(r)
        return 0

    if r.veredito == "SEM_REGISTRO":
        parcial = "" if r.sentido_ativo else " PARCIAL"
        print(
            f"SEM REGISTRO{parcial} — procurei em todo o histórico e não há nada "
            f"sobre isso.\n"
            f"(A busca RODOU até o fim{'' if r.sentido_ativo else ', mas SEM a busca por sentido'}. "
            + (
                'Este é um "não há registro" que se pode afirmar: responda "não tenho '
                "registro disso\" e não complete de memória.)"
                if r.sentido_ativo
                else "Diga ao operador que a busca por sentido estava fora e que o "
                'resultado é parcial.)'
            )
        )
        print()
        if r.radicais_uteis or r.literais:
            print(f"   procurei por: {', '.join(r.literais + r.radicais_uteis)}")
        # Dedupe sem diferenciar caixa: a palavra crua ("Zendesk") e o radical
        # dela ("zendesk") chegam por caminhos diferentes e são a mesma notícia.
        ausentes, vistos = [], set()
        for termo in r.literais_ausentes + r.radicais_ausentes:
            if termo.lower() not in vistos:
                vistos.add(termo.lower())
                ausentes.append(termo)
        if ausentes:
            # Isto é quase a resposta: o termo NUNCA foi dito no histórico.
            print("   nunca apareceu no histórico: " + ", ".join(ausentes))
        if r.radicais_banais:
            print(
                "   ignorei (comuns demais no acervo para discriminar): "
                + ", ".join(r.radicais_banais)
            )
        print()
        print(
            "💡 Busca por um TERMO isolado é a mais fraca das três: se o assunto "
            "pode ter sido dito com outras palavras, tente de novo com uma "
            "FRASE descrevendo a ideia — é a busca por sentido que acha "
            "paráfrase, e ela precisa de contexto para funcionar."
        )
        _rodape(r)
        return 0

    if r.veredito == "MENCAO_LITERAL":
        print(
            f"MENÇÃO LITERAL — a(s) palavra(s) {', '.join(r.literais)} "
            "aparece(m) no histórico, e a busca por SENTIDO não passou do piso.\n"
            "\n"
            "O QUE ISTO SIGNIFICA, EXATAMENTE: eu não consigo confirmar que os "
            "trechos abaixo respondem à pergunta — e **também não consigo "
            "afirmar que não respondem**. LEIA e julgue.\n"
            "  · se forem fora de contexto (a palavra aparece falando de outra "
            "coisa), diga isso ao operador e NÃO costure os trechos numa "
            "resposta;\n"
            "  · se algum deles responder, cite normalmente, pelo #número e pela "
            "data.\n"
            "A nota de cada trecho vai ao lado dele."
        )
        print()
        _imprimir_achados(r)
        print(
            "💡 Busca por um TERMO isolado é a mais fraca das três: se o assunto "
            "pode ter sido dito com outras palavras, tente de novo com uma "
            "FRASE descrevendo a ideia — é a busca por sentido que acha "
            "paráfrase, e ela precisa de contexto para funcionar."
        )
        _rodape(r)
        return 0

    if tem_estado:
        print("═" * LARGURA)
        print("EVIDÊNCIA — as falas literais")
        print("═" * LARGURA)
        print()
    print(f"{len(r.achados)} trecho(s) do histórico:")
    print()
    _imprimir_achados(r)
    print(
        "(Cite pelo #número e pela data ao responder. Se algo aqui não responde "
        "a pergunta, diga que não responde — não preencha a lacuna de memória.)\n"
        "⚠️  Um trecho marcado como `operador` pode ser uma PERGUNTA que ele fez, "
        "não uma decisão. Uma pergunta parecida com a de agora é um vizinho "
        "próximo por construção — leia antes de citar como se fosse resposta."
    )
    print()
    _rodape(r)
    return 0


if __name__ == "__main__":
    sys.exit(main())
