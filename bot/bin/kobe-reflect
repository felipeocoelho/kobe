#!/usr/bin/env python3
"""kobe-reflect — resposta CITADA da memória durável (Hindsight) sob demanda.

O caminho CONFIÁVEL da memória durável (Highlander v2, F3). Enquanto o recall cru
(quando ligado) injeta PISTAS baratas todo turno, o `reflect` é o motor cético+citado:
sintetiza uma resposta a partir SÓ das memórias, com as fontes, e o bank é configurado
cético por construção (skepticism=5, literalism=5) + a directive de Fundamentação. Use
quando a confiança pesa ("o que a gente decidiu sobre X?", "tenho certeza que o operador
disse Y?") — a resposta vem fundamentada ou diz que não há registro.

  kobe-reflect "<pergunta>"

Escopo = tópico atual (KOBE_CHAT_ID/KOBE_THREAD_ID injetados pelo bot) → bank
`kobe-<slug>`. Dev Kobe não puxa Olimpo. Saída em texto no stdout. Best-effort: se o
serviço Hindsight estiver fora, avisa e sai sem derrubar nada.

SAÍDA — três desfechos, três textos, e a distinção é o ponto (conserto de 29/08/2026)
--------------------------------------------------------------------------------------
Até este conserto havia DOIS desfechos possíveis no código e UM texto na tela: tanto
"o acervo não tem isso" quanto "o cliente desistiu de esperar" imprimiam a mesma frase
("sem registro durável"). Como o agente que lê esta saída é instruído a tratar vazio
como ausência de registro, um `ReadTimeout` virava a afirmação "não há registro sobre
isso" — falso negativo silencioso, medido: o servidor concluiu em 28,1 s com resposta
boa e fontes citadas, o cliente cortou aos 20 s. Agora:

  exit 0 + a seção citada   → veio resposta fundamentada
  exit 0 + "LEGÍTIMO"       → o serviço respondeu e o acervo não cobre a pergunta
  exit 3 + "FALHA DO ..."   → timeout / serviço fora / HTTP != 2xx: NÃO se sabe se há
                              registro, porque a pergunta não chegou a ser respondida

O teto de espera é `HINDSIGHT_REFLECT_TIMEOUT` (segundos; default 90).
"""

from __future__ import annotations

import argparse
import asyncio
import importlib.util
import os
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

# Re-exec no venv do projeto se as deps não estiverem no interpretador atual
# (mesmo padrão do kobe-recall — o shebang resolve pro Python do sistema).
_VENV_PY = _REPO_ROOT / ".venv" / "bin" / "python"
# Conferir TODAS as dependências, não uma delas (conserto de 2026-08-27, F0.2).
# O guard antigo olhava só `psycopg`: numa máquina onde o python do sistema tem
# psycopg mas NÃO tem httpx — que é o caso desta VPS —, ele decidia que estava
# tudo bem, não re-exec-utava no venv, e o script morria duas linhas abaixo com
# `ModuleNotFoundError: No module named 'httpx'`. Achado ao rodar o cenário F6
# do plano de testes da F0: o helper estava quebrado no caminho em que o agente
# de fato o chama. Uma dependência a menos na lista = o mesmo bug de volta.
if (
    _VENV_PY.exists()
    and sys.executable != str(_VENV_PY)
    and any(
        importlib.util.find_spec(dep) is None for dep in ("psycopg", "httpx", "dotenv")
    )
):
    os.execv(str(_VENV_PY), [str(_VENV_PY), *sys.argv])

# Dir dos helpers no sys.path pra importar `_kobe_topic` (leitura do `.env`).
_HELPER_DIR = Path(__file__).resolve().parent
if str(_HELPER_DIR) not in sys.path:
    sys.path.insert(0, str(_HELPER_DIR))

from _kobe_topic import read_dotenv  # noqa: E402
from bot import hindsight_client  # noqa: E402
from bot.topic_manager import get_topic_slug  # noqa: E402


def _timeout() -> float:
    """Teto de espera do reflect, em segundos.

    `read_dotenv` olha `os.environ` primeiro e cai no `.env` do projeto depois —
    o helper roda tanto como subprocess do bot (env injetada) quanto na mão.
    Valor malformado NÃO derruba o helper: avisa e usa o default. Uma env torta
    não pode ser o motivo de a memória durável ficar inacessível."""
    raw = (read_dotenv({"HINDSIGHT_REFLECT_TIMEOUT"}).get(
        "HINDSIGHT_REFLECT_TIMEOUT") or "").strip()
    if not raw:
        return hindsight_client.REFLECT_TIMEOUT_DEFAULT
    try:
        valor = float(raw)
    except ValueError:
        print(
            f"kobe-reflect: HINDSIGHT_REFLECT_TIMEOUT={raw!r} não é número; "
            f"usando {hindsight_client.REFLECT_TIMEOUT_DEFAULT:g}s.",
            file=sys.stderr,
        )
        return hindsight_client.REFLECT_TIMEOUT_DEFAULT
    if valor <= 0:
        print(
            f"kobe-reflect: HINDSIGHT_REFLECT_TIMEOUT={raw!r} não é positivo; "
            f"usando {hindsight_client.REFLECT_TIMEOUT_DEFAULT:g}s.",
            file=sys.stderr,
        )
        return hindsight_client.REFLECT_TIMEOUT_DEFAULT
    return valor


def _db():
    from bot.db import KobeDB

    url = os.environ.get("DATABASE_URL")
    if not url:
        print("kobe-reflect: DATABASE_URL ausente.", file=sys.stderr)
        sys.exit(2)
    return KobeDB(url)


def _resolve_slug() -> str | None:
    chat_raw = os.environ.get("KOBE_CHAT_ID")
    thread_raw = os.environ.get("KOBE_THREAD_ID")
    if not chat_raw:
        return None
    try:
        chat_id = int(chat_raw)
    except ValueError:
        return None
    thread_id = None
    if thread_raw not in (None, ""):
        try:
            thread_id = int(thread_raw)
        except ValueError:
            thread_id = None
    db = None
    try:
        db = _db()
        return get_topic_slug(db, chat_id, thread_id)
    except Exception as exc:  # noqa: BLE001
        print(f"kobe-reflect: não resolvi o tópico ({exc}).", file=sys.stderr)
        return None
    finally:
        # Processo de vida curta: fecha o pool em vez de deixar a conexão
        # pendurada no servidor até o interpretador morrer.
        if db is not None:
            db.close()


def _texto_de_falha(status: str, detail: str, base_url: str) -> str:
    """A frase que o agente lê quando o instrumento falhou.

    Escrita em tom imperativo e com o "NÃO é sem registro" em caixa alta de
    propósito: quem lê isto é um LLM que o CLAUDE.md ensinou a tratar saída vazia
    como ausência de registro. A frase precisa vencer esse reflexo — se ela for
    branda, o falso negativo volta pela porta do comportamento, mesmo com o
    código certo."""
    cabeca = f'(FALHA DO INSTRUMENTO — isto NÃO é "sem registro". {detail}.'
    if status == "timeout":
        rabo = (
            "NÃO conclua que não há registro: a pergunta não chegou a ser "
            "respondida, e o acervo pode muito bem ter a resposta. Tente de novo "
            "(a 2ª chamada costuma ser bem mais rápida que a fria) ou suba "
            "HINDSIGHT_REFLECT_TIMEOUT."
        )
    elif status == "servico_fora":
        rabo = (
            "NÃO conclua que não há registro: a consulta nem chegou ao acervo. "
            f"Confira se o serviço Hindsight está de pé em {base_url}."
        )
    else:
        rabo = (
            "NÃO conclua que não há registro: a consulta falhou antes de ter "
            "resposta."
        )
    return f"{cabeca}\n{rabo})"


def main() -> int:
    ap = argparse.ArgumentParser(description="Reflect citado da memória durável")
    ap.add_argument("query", nargs="*", help="a pergunta")
    args = ap.parse_args()
    query = " ".join(args.query).strip()
    if not query:
        print('Uso: kobe-reflect "<pergunta>"', file=sys.stderr)
        return 2

    slug = _resolve_slug()
    bank = hindsight_client.bank_id_for_topic(slug)
    base_url = os.environ.get("HINDSIGHT_BASE_URL", hindsight_client.DEFAULT_BASE_URL)

    timeout = _timeout()
    outcome = asyncio.run(
        hindsight_client.reflect(base_url, bank, query, timeout=timeout)
    )

    if not outcome.ok:
        # O serviço não chegou a responder. Dizer "sem registro" aqui seria a
        # mentira que este helper existe pra não contar.
        print(f"kobe-reflect: {outcome.detail}", file=sys.stderr)
        print(_texto_de_falha(outcome.status, outcome.detail, base_url))
        return 3

    section = hindsight_client.render_reflect_section(outcome)
    if not section:
        # 2xx sem texto: a consulta RODOU até o fim e o acervo não cobre. Este é
        # o único "não há registro" que se pode afirmar.
        print(
            '(O Hindsight RESPONDEU, e o acervo não tem registro que cubra isso. '
            'Este é um "não há registro" LEGÍTIMO — a consulta rodou até o fim. '
            "Não há base; não afirme de memória.)"
        )
        return 0
    print(section)
    return 0


if __name__ == "__main__":
    sys.exit(main())
